<Window x:Class="InterviewOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="480"
        Background="#17181C" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="Foreground" Value="#4C8BF5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>
    </Window.Resources>
    <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="Bold"/>

            <TextBlock Text="GENERAL" Style="{StaticResource Section}"/>
            <CheckBox Name="StartWithWindowsCheck" Content="Start Interview Overlay with Windows"/>
            <CheckBox Name="MinimizeToTrayCheck" Content="Minimize to system tray on close"/>

            <TextBlock Text="OVERLAY" Style="{StaticResource Section}"/>
            <CheckBox Name="AlwaysOnTopCheck" Content="Always on top"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Theme:" VerticalAlignment="Center" Width="90"/>
                <ComboBox Name="ThemeCombo" Width="150">
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="HOTKEYS (click a box, then press your combo)" Style="{StaticResource Section}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Show/Hide overlay" VerticalAlignment="Center"/>
                <TextBox Name="HotkeyToggle" Grid.Row="0" Grid.Column="1" Background="#1E1F24" Foreground="White" BorderThickness="0" Padding="4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock Grid.Row="1" Text="Increase opacity" VerticalAlignment="Center"/>
                <TextBox Name="HotkeyOpacityUp" Grid.Row="1" Grid.Column="1" Background="#1E1F24" Foreground="White" BorderThickness="0" Padding="4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock Grid.Row="2" Text="Decrease opacity" VerticalAlignment="Center"/>
                <TextBox Name="HotkeyOpacityDown" Grid.Row="2" Grid.Column="1" Background="#1E1F24" Foreground="White" BorderThickness="0" Padding="4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock Grid.Row="3" Text="Increase text size" VerticalAlignment="Center"/>
                <TextBox Name="HotkeyFontUp" Grid.Row="3" Grid.Column="1" Background="#1E1F24" Foreground="White" BorderThickness="0" Padding="4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock Grid.Row="4" Text="Decrease text size" VerticalAlignment="Center"/>
                <TextBox Name="HotkeyFontDown" Grid.Row="4" Grid.Column="1" Background="#1E1F24" Foreground="White" BorderThickness="0" Padding="4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock Grid.Row="5" Text="Detach window" VerticalAlignment="Center"/>
                <TextBox Name="HotkeyDetach" Grid.Row="5" Grid.Column="1" Background="#1E1F24" Foreground="White" BorderThickness="0" Padding="4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            </Grid>
            <TextBlock Text="Hotkey changes apply the next time you launch the app." Foreground="#777" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Reset Overlay Position" Click="ResetPosition_Click" Padding="8,5" Margin="0,0,8,0"/>
                <Button Content="Close" Width="90" Click="Close_Click" Padding="6" Background="#4C8BF5" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
