<Window x:Class="InterviewOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Notes"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="420"
        MinWidth="220" MinHeight="160">

    <Border CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Name="RootPanel"
            Background="#1E1F24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <!-- Title bar (drag handle) -->
            <Grid DockPanel.Dock="Top" Height="30" Background="#22FFFFFF"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Name="TitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="INTERVIEW NOTES" Foreground="White" FontWeight="SemiBold"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                           Opacity="0.85"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Name="LockButton" Content="🔓" Width="24" Height="24" Margin="2,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="Toggle click-through" Click="LockButton_Click"/>
                    <Button Content="—" Width="24" Height="24" Margin="2,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="Hide overlay (Ctrl+Shift+H)" Click="Hide_Click"/>
                    <Button Content="✕" Width="24" Height="24" Margin="2,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="Detach and close" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Notes body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
                <TextBlock Name="NotesText"
                           TextWrapping="Wrap"
                           Foreground="#F0F0F0"
                           FontSize="15"
                           LineHeight="20"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
